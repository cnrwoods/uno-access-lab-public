@page "/access-denied"
@model ManagementPortal.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access required";
}

<section class="welcome" aria-labelledby="access-title">
    <p class="eyebrow">Portal access</p>
    <h1 id="access-title">Access required.</h1>
    <p class="intro">Your account doesn’t have permission to use this management portal. Contact the portal administrator to request access.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form method="post" asp-page="/Logout">
            <button class="primary-link" type="submit">Sign out</button>
        </form>
    }
    else
    {
        <a class="primary-link" asp-page="/Login">Log in</a>
    }
</section>
